Implementation approach:
Implement streak logic with a 1-day grace period. A streak is maintained if the user completes at least one session today OR completed one yesterday (grace day). If both days are missed, the streak resets.

Logic:


class StreakService {
  Future<StreakData> checkStreakStatus() async {
    final statsRepo = await statsRepositoryProvider.future;
    final today = DateTime.now();
    final yesterday = today.subtract(const Duration(days: 1));
    
    final hasToday = await statsRepo.getSessionsForDate(today).then(
      (s) => s.isNotEmpty
    );
    final hasYesterday = await statsRepo.getSessionsForDate(yesterday).then(
      (s) => s.isNotEmpty
    );
    
    if (hasToday) {
      // Streak continues or increments
      return StreakData(currentStreak: currentStreak + 1, lastActiveDate: today);
    } else if (hasYesterday) {
      // Grace day — streak frozen, not lost
      return StreakData(currentStreak: currentStreak, lastActiveDate: yesterday, isGraceDay: true);
    } else {
      // Streak lost
      return StreakData(currentStreak: 0, lastActiveDate: null);
    }
  }
}
