class EnergyInsight {
  final String title;
  final String body;
  final InsightType type; // peak_time, energy_pattern, tip

  static List<EnergyInsight> generate(List<FlowSession> sessions) {
    final insights = <EnergyInsight>[];
    // Analyze: what time of day gets the longest sessions?
    final byHour = groupBy(sessions, (s) => s.startedAt.hour);
    final peakHour = byHour.entries
        .map((e) => MapEntry(e.key, e.value.length))
        .reduce((a,b) => a.value > b.value ? a : b).key;
    insights.add(EnergyInsight(
      title: '⚡ Your peak hour',
      body: 'You\'re most productive around ${_hourLabel(peakHour)}.',
      type: InsightType.peakTime,
    ));
    // More insights...
    return insights;
  }
}
Expose as energyInsightProvider = FutureProvider<List<EnergyInsight>> that reads session history and computes insights on demand.

