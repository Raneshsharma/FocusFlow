String _getBreakSuggestion(List<FlowSession> recentSessions) {
  if (recentSessions.isEmpty) return 'Take a walk outside — fresh air resets your brain.';
  final avgDuration = recentSessions.map((s) => s.durationSeconds).reduce((a,b) => a+b) / recentSessions.length;
